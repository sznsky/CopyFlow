# 复制为 .env 后按需修改（也可直接改 config/config.yaml）

# 运行环境：dev / test / prod（对应 config/config.dev.yaml / config.test.yaml / config.prod.yaml）
APP_ENV=dev

# 服务
SERVER_PORT=8080
SERVER_MODE=debug

# 数据库
DATABASE_DSN=copyflow:copyflow@tcp(127.0.0.1:3306)/copyflow?charset=utf8mb4&parseTime=True&loc=Local

# 鉴权（生产环境务必修改）
AUTH_JWT_SECRET=change-me-in-production
AUTH_WALLET_ENCRYPT_KEY=0123456789abcdef0123456789abcdef

# Worker
WORKER_ENABLED=true
WORKER_POLL_INTERVAL_SEC=3
WORKER_CONFIRMATIONS=1

# BSC RPC（可换为 Alchemy/QuickNode 等）
CHAINS_BSC_RPC_URL=https://bsc-dataseed.binance.org
CHAINS_BSC_ENABLED=true

# Ethereum（默认关闭，启用时设 CHAINS_ETHEREUM_ENABLED=true）
CHAINS_ETHEREUM_ENABLED=false
CHAINS_ETHEREUM_RPC_URL=https://eth.llamarpc.com
